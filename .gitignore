# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# 工具缓存
.pytest_cache/
.ruff_cache/
.import_linter_cache/

# 构建产物
dist/
build/

# 运行时结果日志(--silent 落盘,默认在项目 logs/ 下,见 core/adapters/log_dir.py)
logs/

# 运行时数据(SQLite 台账等可变状态,默认在项目 data/ 下,见 core/adapters/log_dir.py)
data/

# 本机覆盖配置: 含本机路径/容器名等差异,禁止入库(见 docs/standards/STD-02)
config/domains/*.local.yaml

# Web 管理台前端(SPEC-09): 依赖与构建产物均不入库
frontend/node_modules/
.playwright-cli/

# macOS 桌面元数据,与项目无关
.DS_Store
