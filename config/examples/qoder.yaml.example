# 复制为 config/domains/qoder.local.yaml(不入库)后按需改
base_url: https://openapi.qoder.com.cn
log_empty: false
budget_seconds: 240

# 多账户(SPEC-12,可选): 不声明 = 单账户 default,存量配置零改动。
# 每个账户独立凭据与台账;调度按账户展开成 @账户 任务并错峰。
# 具名账户只认显式数据目录(auth_dir = 另一份客户端数据目录,
# 含 Client/<版本>/local_storage 等登录态),并隔离 QODER_TOKEN 环境变量。
# accounts:
#   - name: main
#   - name: backup
#     auth_dir: "D:/clients/qoder-backup"
#     # enabled: false
#   - name: cn                 # macOS 两版客户端各一份 Keychain 密钥:
#     auth_dir: "~/Library/Application Support/com.qodercn.app.stable"
#     # 默认按数据目录名自动选对(qodercn → 国内版条目);客户端改名或换渠道包时
#     # 显式指定条目名(acct 由它派生: "X Safe Storage" → "X Key"):
#     keychain_service: "Qoder CN App Safe Storage"
