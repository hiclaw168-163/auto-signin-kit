# 复制为 config/domains/trae.local.yaml(不入库)后按需改
base_url: https://api.trae.cn
log_empty: false
budget_seconds: 240
# 桌面端数据目录(含 User/globalStorage/storage.json 的根);null=按平台默认探测
data_dir: null

# 多账户(SPEC-12,可选): 不声明 = 单账户 default,存量配置零改动。
# trae 凭据与设备同文件(storage.json 键名藏设备号),多账户 = 多数据目录:
# 每个账户一套独立客户端数据目录拷贝,auth_dir 指向各自根(含 User/globalStorage)。
# accounts:
#   - name: main
#   - name: backup
#     auth_dir: "D:/clients/trae-backup"
#     # enabled: false
