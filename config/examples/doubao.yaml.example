# doubao 域: 豆包(电脑版)每日签到领额度。
# 本域从豆包客户端本地数据目录解密会话 Cookie(仅 Windows),再调 Web 端
# 签到接口;取证与接口契约见 docs/notes/NOTE-04。
base_url: https://www.doubao.com
# 签到活动标识;字节换季时会换值,报 "campaign not found" 时改这里(见 NOTE-04)。
campaign_code: pc_incentive_task_mvp_v3
# 豆包客户端数据目录;留空 = 自动探测 %LOCALAPPDATA%/Doubao/User Data。
# user_data_dir: D:/software/ai-tools/Doubao/UserData
# CDP 调试端口(macOS 唯一 Cookie 通道): 须与豆包客户端启动参数
# --remote-debugging-port 一致;环境变量 DOUBAO_CDP_PORT 仍优先。
cdp_port: 9223
# 时间预算(秒),计划任务 PT5M 上限 240。
budget_seconds: 240

# 多账户(SPEC-12,可选): 不声明 = 单账户 default,存量配置零改动。
# 多账户 = 豆包客户端多开: 每账户一份独立 User Data + 一个独立调试端口,
# 各自用桌面快捷方式带 --remote-debugging-port=<port> 启动并登录。
# accounts:
#   - name: main
#   - name: second
#     user_data_dir: "D:/software/DoubaoSecond/User Data"
#     cdp_port: 9223
#     # enabled: false
